using System.Text.Json;

var handler = new HttpClientHandler
{
    ServerCertificateCustomValidationCallback = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator
};

using HttpClient client = new(handler);

try
{
    string json = await client.GetStringAsync("https://localhost:7283/api/students");
    Console.WriteLine("Original Response:");
    Console.WriteLine(json);
    Console.WriteLine();

    using JsonDocument doc = JsonDocument.Parse(json);

    Console.WriteLine("Reversed Strings:");

    if (doc.RootElement.ValueKind == JsonValueKind.Array)
    {
        foreach (JsonElement student in doc.RootElement.EnumerateArray())
        {
            foreach (JsonProperty prop in student.EnumerateObject())
            {
                if (prop.Value.ValueKind == JsonValueKind.String)
                {
                    string original = prop.Value.GetString()!;
                    string reversed = new(original.Reverse().ToArray());
                    Console.WriteLine($"{prop.Name}: \"{original}\" -> \"{reversed}\"");
                }
                else
                {
                    Console.WriteLine($"{prop.Name}: {prop.Value}");
                }
            }
            Console.WriteLine("---");
        }
    }
}
catch (HttpRequestException ex)
{
    Console.WriteLine($"Error fetching data: {ex.Message}");
}
