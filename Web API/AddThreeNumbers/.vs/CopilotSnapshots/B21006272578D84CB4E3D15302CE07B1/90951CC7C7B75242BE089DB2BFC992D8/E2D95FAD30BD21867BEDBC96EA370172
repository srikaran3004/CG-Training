using Microsoft.AspNetCore.Mvc;

namespace AddThreeNumbers.Controllers
{
    [ApiController]
    [Route("[controller]")]
    public class SumController : ControllerBase
    {
        [HttpGet]
        public ActionResult<int> GetSum([FromQuery] int a, [FromQuery] int b, [FromQuery] int c)
        {
            return a + b + c;
        }
    }
}
