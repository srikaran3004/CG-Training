-- Stored Procedure for Pagination
CREATE OR ALTER PROCEDURE sp_GetPersonsPaged
    @PageNumber INT = 1,
    @PageSize   INT = 10
AS
BEGIN
    SET NOCOUNT ON;

    -- Return total record count
    SELECT COUNT(*) AS TotalCount FROM Person;

    -- Return paged records
    IF @PageSize = 0
    BEGIN
        -- Return all records when PageSize is 0 (All button)
        SELECT PersonID, FirstName, LastName, Age, City
        FROM Person
        ORDER BY PersonID;
    END
    ELSE
    BEGIN
        SELECT PersonID, FirstName, LastName, Age, City
        FROM Person
        ORDER BY PersonID
        OFFSET (@PageNumber - 1) * @PageSize ROWS
        FETCH NEXT @PageSize ROWS ONLY;
    END
END
GO
