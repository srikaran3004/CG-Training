@model PersonPaginationViewModel
@{
    ViewData["Title"] = "Person List";
}

<style>
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }
    th, td {
        border: 1px solid #999;
        padding: 8px 12px;
        text-align: left;
    }
    th {
        background-color: #4a90d9;
        color: #fff;
    }
    tr:nth-child(even) {
        background-color: #f2f2f2;
    }
    .pagination-bar {
        margin-top: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .pagination-bar a {
        display: inline-block;
        padding: 8px 18px;
        border: 1px solid #4a90d9;
        color: #4a90d9;
        text-decoration: none;
        border-radius: 4px;
        font-weight: bold;
    }
    .pagination-bar a:hover {
        background-color: #4a90d9;
        color: #fff;
    }
    .pagination-bar .disabled {
        pointer-events: none;
        opacity: 0.5;
    }
    .pagination-bar .active {
        background-color: #4a90d9;
        color: #fff;
    }
    .page-info {
        font-size: 14px;
        color: #555;
    }
</style>

<h2>Person Records</h2>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Age</th>
            <th>City</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in Model.Persons)
        {
            <tr>
                <td>@person.PersonID</td>
                <td>@person.FirstName</td>
                <td>@person.LastName</td>
                <td>@person.Age</td>
                <td>@person.City</td>
            </tr>
        }
    </tbody>
</table>

<div class="pagination-bar">
    @if (Model.ShowAll)
    {
        <a asp-action="Index" asp-route-page="1">Back to Paged</a>
        <span class="page-info">Showing all @Model.TotalRecords records</span>
    }
    else
    {
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
           class="@(Model.CurrentPage <= 1 ? "disabled" : "")">Prev</a>

        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
           class="@(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">Next</a>

        <a asp-action="Index" asp-route-showAll="true" class="active">All</a>

        <span class="page-info">
            Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalRecords total records)
        </span>
    }
</div>
